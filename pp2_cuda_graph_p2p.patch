+def _run_p2p(op, tensor: torch.Tensor, peer: int) -> None:
+    """Run one P2P op through the CUDA-graph-compatible batched API."""
+    group = get_pipeline_model_parallel_group()
+    works = torch.distributed.batch_isend_irecv(
